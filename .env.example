# Non-secret examples only. Inject real secrets through your deployment secret manager.
GITHUB_TOKEN=
REASONING_API_MODEL=claude-4.6-opus
# Optional endpoint override. GitHub Actions uses the Bitgo production endpoint.
REASONING_API_ENDPOINT=
REASONING_PRIVATE_KEY=
# ECDSA P-256 PEM for X-Signature. In GitHub Actions, store the full PEM as a Secret.
REASONING_INTERFACE_PRIVATE_KEY_PEM=
# Required: ltc, btc, or eth; provided by a person for the registered wallet.
REASONING_WALLET_CHAIN=YOUR_WALLET_CHAIN
REASONING_WALLET_ADDRESS=
# Required: wallet amount provided by a person for the registered wallet.
REASONING_MONEY=YOUR_WALLET_MONEY
# Stable bitgo zero-wallet ID. model-check generates and saves one locally when omitted.
# Set this explicitly in GitHub Actions Secrets because its runner is ephemeral.
REASONING_MONEY_ID=
REASONING_SIGNER_COMMAND=
RESEND_MANAGEMENT_API_KEY=
GITHUB_AI_MAIL_TEST_TO=
GITHUB_AI_MAIL_BACKEND=auto

# Optional override when the agent environment has a dedicated Agent Mail sender.
# Example: Agent Mail <agent@verified.example>
GITHUB_AI_MAIL_FROM=

# Gmail API delivery for `model-check --send-email`.
# Keep both JSON values in local files or deployment secrets; never commit them.
MAIL_FROM=
REPORT_RECIPIENTS=
# model-check --send-email: auto prefers authorized Agent Mail, otherwise Gmail OAuth.
MODEL_CHECK_MAIL_BACKEND=auto
VPS_CHECK_API_BASE_URL=https://api-bitgo.enigmhaven.com
# Reusable Bitgo SSH Key ID. Keep this stable after the first vps-check run.
VPS_CHECK_SSH_KEY_ID=
# Optional local private-key path. When no Key ID or public key is supplied,
# vps-check creates an Ed25519 key here (default: user config directory).
VPS_CHECK_SSH_PRIVATE_KEY_PATH=
# OpenSSH public key, used only to create the reusable Bitgo SSH Key when no ID exists.
# Never put an SSH private key here.
VPS_CHECK_SSH_PUBLIC_KEY=
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# Required on headless Linux when no usable Secret Service is available.
# Commands receive the secret name as their final argument.
# PUT receives the secret value on stdin; GET writes it to stdout.
GITHUB_AI_SECRET_GET_CMD=
GITHUB_AI_SECRET_PUT_CMD=
GITHUB_AI_SECRET_DELETE_CMD=
